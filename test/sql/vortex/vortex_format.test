# name: test/sql/vortex/vortex_format.test
# description: read+write DuckLake data files in the vortex format, incl. mixed parquet+vortex
# group: [vortex]
#
# Requires the vortex extension (the ./vortex submodule). NOTE: the vortex extension currently pins an
# older DuckDB than DuckLake main (its C++ glue uses Vector::GetBuffer / Flatten(count), removed in the
# DuckDB that DuckLake tracks), so this test only runs on a build where the two DuckDB pins are aligned.
# The identical read-dispatch code path is exercised format-agnostically by
# test/sql/format/json_read_dispatch.test in every build.

require ducklake

require parquet

require vortex

statement ok
ATTACH 'ducklake:{TEST_DIR}/dl_vortex.db' AS ducklake (DATA_PATH '{TEST_DIR}/dl_vortex_files', METADATA_CATALOG 'ducklake_meta')

# write every insert to a data file (no metadata inlining)
statement ok
CALL ducklake.set_option('data_inlining_row_limit', 0)

statement ok
CALL ducklake.set_option('data_file_format', 'vortex')

statement ok
CREATE TABLE ducklake.t(i INTEGER, s VARCHAR, d DOUBLE, b BOOLEAN, l INTEGER[]);

statement ok
INSERT INTO ducklake.t VALUES
    (1, 'a', 1.5, true, [1, 2, 3]),
    (2, NULL, NULL, NULL, NULL),
    (3, 'ccc', -2.25, false, []);

query I
SELECT DISTINCT file_format FROM ducklake_meta.ducklake_data_file
----
vortex

query I
SELECT COUNT(*) FROM glob('{TEST_DIR}/dl_vortex_files/**/*.vortex')
----
1

query IIIII
SELECT i, s, d, b, l FROM ducklake.t ORDER BY i
----
1	a	1.5	true	[1, 2, 3]
2	NULL	NULL	NULL	NULL
3	ccc	-2.25	false	[]

query II
SELECT i, s FROM ducklake.t WHERE i >= 2 ORDER BY i
----
2	NULL
3	ccc

query RR
SELECT SUM(i), MIN(d) FROM ducklake.t
----
6	-2.25

statement ok
DELETE FROM ducklake.t WHERE i = 2;

query II
SELECT i, s FROM ducklake.t ORDER BY i
----
1	a
3	ccc

# mixed vortex + parquet in one table
statement ok
CALL ducklake.set_option('data_file_format', 'parquet')

statement ok
INSERT INTO ducklake.t VALUES (4, 'parq', 4.0, true, [9]);

query I
SELECT COUNT(DISTINCT file_format) FROM ducklake_meta.ducklake_data_file WHERE end_snapshot IS NULL
----
2

query II
SELECT i, s FROM ducklake.t ORDER BY i
----
1	a
3	ccc
4	parq

query I
SELECT SUM(i) FROM ducklake.t
----
8
